#-PRE
# Local Linux SDL/OpenGL build, with tty retained as a fallback.

# Typical install path for normal user (non-root)
PREFIX=$(if $(EVILHACK_PREFIX),$(EVILHACK_PREFIX),$(HOME)/.local)
HACKDIR=$(PREFIX)/games/evilhackdir

# Default install path (assumes running at root)
#PREFIX=/usr
#HACKDIR=$(PREFIX)/games/lib/$(GAME)dir

SHELLDIR = $(PREFIX)/games
INSTDIR = $(HACKDIR)
VARDIR = $(HACKDIR)/var

POSTINSTALL=test -f $(INSTDIR)/sysconf || sed '/^LIVELOG=/d' sys/unix/sysconf > $(INSTDIR)/sysconf; $(CHOWN) $(GAMEUID) $(INSTDIR)/sysconf; $(CHGRP) $(GAMEGRP) $(INSTDIR)/sysconf; chmod $(VARFILEPERM) $(INSTDIR)/sysconf; cp dat/serverseed $(INSTDIR)/serverseed; $(CHOWN) $(GAMEUID) $(INSTDIR)/serverseed; $(CHGRP) $(GAMEGRP) $(INSTDIR)/serverseed; chmod $(VARFILEPERM) $(INSTDIR)/serverseed;

CFLAGS=-g -O2 -std=gnu17 -I../include -DNOTPARMDECL -fno-common
CFLAGS+=-DDLB
CFLAGS+=-DCOMPRESS=\"/bin/gzip\" -DCOMPRESS_EXTENSION=\".gz\"
CFLAGS+=-Wno-unused-result -Wno-format-overflow
CFLAGS+=-DSYSCF -DSYSCF_FILE=\"$(HACKDIR)/sysconf\" 
CFLAGS+=-DTIMED_DELAY
CFLAGS+=-DHACKDIR=\"$(HACKDIR)\"
CFLAGS+=-DVAR_PLAYGROUND=\"$(HACKDIR)/var\"
CFLAGS+=-DCONFIG_ERROR_SECURE=FALSE
CFLAGS+=-DGL_GRAPHICS -DSDL_GRAPHICS -DUSE_TILES -DSTATUES_LOOK_LIKE_MONSTERS
CFLAGS+=-DPANICLOG_FMT2
CFLAGS+=-DFCMASK=0644
CFLAGS+=-DTTY_TILES_ESCCODES
CFLAGS+=-DSCORE_ON_BOTL
CFLAGS+=-DREALTIME_ON_BOTL
CFLAGS+=
CFLAGS+=-DLIVELOG_ENABLE
CFLAGS+=-DDUMPLOG
CFLAGS+=-DDUMPHTML

#detection of clang vs gcc
CCISCLANG := $(shell echo `$(CC) --version` | grep clang)
ifneq "$(CCISCLANG)" ""
CLANGGTEQ18 := $(shell expr `$(CC) -dumpversion | cut -f1 -d.` \>= 18)
ifeq "$(CLANGGTEQ18)" "1"
# clang-specific starts here
CFLAGS+=-Wno-deprecated-non-prototype
endif
# clang-specific ends here
else
# gcc-specific starts here
CFLAGS+=-Wno-old-style-definition -Wno-unused-result -Wno-format-overflow
# gcc-specific ends here
endif  # clang-specific or gcc-specific ends here

LINK=$(CC)
# Only needed for GLIBC stack trace:
LFLAGS=-rdynamic

WINSRC = $(WINTTYSRC) $(wildcard ../win/gl/*.c)
WINOBJ = $(WINTTYOBJ) $(patsubst ../win/gl/%.c,%.o,$(wildcard ../win/gl/*.c))
WINLIB = $(WINTTYLIB) $(shell sdl-config --libs) -lGL -lpng -lz

# if TTY_TILES_ESCCODES
WINSRC += tile.c
WINOBJ += tile.o

WINTTYLIB=$(shell pkg-config --libs ncursesw)

CHOWN=true
CHGRP=true

VARDIRPERM = 0755
VARFILEPERM = 0600
GAMEPERM = 0755

CFLAGS += $(shell sdl-config --cflags)
#-POST
NROFF_SWITCHES = -c -Tascii -wall -Wtab -Wrange -Wscale
gl_%.o: ../win/gl/gl_%.c ../include/winGL.h $(HACK_H) ../include/date.h
	$(CC) $(CFLAGS) -c $< -o $@
